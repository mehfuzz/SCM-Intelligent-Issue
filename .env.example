# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Application base URL (used for callbacks and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: SMTP settings for notification engine
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCM Portal <no-reply@airtel.in>"
